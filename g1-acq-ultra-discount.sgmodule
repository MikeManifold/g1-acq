#!name=G1 ACQ SKU 管理 · v7.12.1-pathfix（北京时间）
#!desc=v7.12.1-pathfix（北京时间 UTC+8），基于官方 v7.12.0；五套模板：1元开Pro、土区20TB公开1989.99TRY、土区30TB公开2949.99TRY、Ultra三个月75p、Pro12个月90p；Pro自身prefix g1.ios.2tb.→com.google.gemini.2tb.ai.m.3month_ip_99p，土区20TB exact g1.ios.20tb.m.v2→g1.ios.20tb.m，两者可同时使用；安装不自动应用，报告点应用Pro才原子停用旧exact20TB→同一Gemini目标并保留其他20TB目标、ID与顺序；同match/from合并启用，超过30条或冲突整次不写，模板保存为custom；Pro12个月切换2TB前缀，Ultra75p与土区模板切换对应20/30TB源；默认三条仍为20TB/30TB75p（实付25%、2.5折）与g1.2tb.ai.12months_ip_90p，无.acq，fallback=false；运行版本g1-acq-v7.12.1-pathfix，支持Gemini；关闭旧副本只开本入口，重新连接、点应用、重进Pro页，核对最近执行版本、mappingRevision与matchedFrom；PR#8购买来自旧20TB入口，金额周期看App Store；保留手动编辑、schema1、采集、10次响应与JSON，不自动迁移或清记录
#!system=ios

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/MikeManifold/g1-acq@v7.12.1-pathfix-20261127/g1-acq-discount.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/MikeManifold/g1-acq@v7.12.1-pathfix-20261127/g1-sku-report-discount.js

[MITM]
hostname = %APPEND% one.google.com
